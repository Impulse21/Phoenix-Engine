{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-debug"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-release"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure RelWithDebInfo",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-relwithdebinfo"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Current Preset",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: Clean Current Preset",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--target",
        "clean"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build JobsSmokeTests",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--target",
        "JobsSmokeTests"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run JobsSmokeTests x100",
      "type": "shell",
      "dependsOn": "CMake: Build JobsSmokeTests",
      "windows": {
        "command": "for ($i = 0; $i -lt 100; $i++) { & \"${command:cmake.buildDirectory}/bin/JobsSmokeTests.exe\"; if ($LASTEXITCODE -ne 0) { break } }"
      },
      "linux": {
        "command": "for i in $(seq 100); do \"${command:cmake.buildDirectory}/bin/JobsSmokeTests\" || break; done"
      },
      "problemMatcher": []
    }
  ]
}