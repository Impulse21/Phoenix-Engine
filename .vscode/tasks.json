{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-debug"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-release"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure RelWithDebInfo",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-relwithdebinfo"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Current Preset",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: Clean Current Preset",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${command:cmake.buildDirectory}",
        "--target",
        "clean"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}