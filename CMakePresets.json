{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Basic Config",
      "description": "Basic build using Ninja generator",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "hidden": true,
      "binaryDir": "${sourceDir}/.out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/.out/install/${presetName}"
      }
    },
    {
      "name": "visual_studio_2022",
      "inherits": "base",
      "displayName": "Basic Config (VS 2022)",
      "description": "Basic build using Visual studio 2022 generator",
      "generator": "Visual Studio 17 2022",
      "hidden": true
    },

    {
      "name": "Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "hidden": true
    },
    {
      "name": "Profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "hidden": true
    },
    {
      "name": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "hidden": true
    },

    {
      "name": "MSVC",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_VS_PLATFORM_TOOLSET": "v143"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "Clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_C_COMPILER": "clang-cl.exe"
      },
      "architecture": "x64",
      "toolset": {
        "value": "ClangCL"
      }
    },
    {
      "name": "RHI_dx12",
      "cacheVariables": {
        "PHX_ENABLE_VULKAN": "OFF",
        "PHX_ENABLE_DX12": "ON"
      },
      "hidden": true
    },
    {
      "name": "RHI_vk",
      "cacheVariables": {
        "PHX_ENABLE_VULKAN": "ON",
        "PHX_ENABLE_DX12": "OFF"
      },
      "hidden": true
    },
    {
      "name": "x64-Debug-Vs2022",
      "description": "MSVC for x64 (Debug)",
      "inherits": [ "visual_studio_2022", "Debug", "MSVC", "RHI_dx12" ]
    },
    {
      "name": "x64-Profile-Vs2022",
      "description": "MSVC for x64 (Profile)",
      "inherits": [ "visual_studio_2022", "Profile", "MSVC", "RHI_dx12" ]
    },
    {
      "name": "x64-Release-Vs2022",
      "description": "MSVC for x64 (Release)",
      "inherits": [ "visual_studio_2022", "Release", "MSVC", "RHI_dx12" ]
    },

    {
      "name": "x64-Debug-Clang-Vs2022",
      "description": "Clang/LLVM for x64 (Debug)",
      "inherits": [ "visual_studio_2022", "Debug", "Clang", "RHI_dx12" ]
    },
    {
      "name": "x64-Profile-Clang-Vs2022",
      "description": "Clang/LLVM for x64 (Profile)",
      "inherits": [ "visual_studio_2022", "Profile", "Clang", "RHI_dx12" ]
    },
    {
      "name": "x64-Release-Clang-Vs2022",
      "description": "Clang/LLVM for x64 (Release)",
      "inherits": [ "visual_studio_2022", "Release", "Clang", "RHI_dx12" ]
    }
  ],

  "vendor": {
    "microsoft.com/VisualStudio": {
      "hostArch": "x64",
      "targetArch": "x64"
    }
  }
}
  