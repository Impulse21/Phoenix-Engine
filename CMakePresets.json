        "cacheVariables": { 
          "CMAKE_C_COMPILER": "ClangCL",
          "CMAKE_CXX_COMPILER": "ClangCL",
          "CMAKE_VS_PLATFORM_TOOLSET": "ClangCL"
        }
      },
      {
        "name": "clang-debug",
        "inherits": "default-clang-cl",
        "description": "Build using Clang with Debug configuration",
        "cacheVariables": {
          "USE_VULKAN": "OFF",
          "USE_DX12": "ON"
        }
      },
      {
        "name": "clang-profile",
        "inherits": "default-clang-cl",
        "description": "Build using Clang with Release configuration",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "USE_VULKAN": "OFF",
          "USE_DX12": "ON"
        }
      },
      {
        "name": "clang-release",
        "inherits": "default-clang-cl",
        "description": "Build using Clang with Release configuration",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "USE_VULKAN": "OFF",
          "USE_DX12": "ON"
        }
      },
      {
        "name": "vs2022-clang-debug",
        "inherits": "default-vs2022-clang",
        "description": "Build using Clang(VS) with Debug configuration",
        "cacheVariables": {
          "USE_VULKAN": "OFF",
