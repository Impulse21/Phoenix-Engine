header:
  asset_type: MaterialArchetypeDef
  asset_id: 566e2ab0-7469-4b2d-b665-d1c9953d4462

name: Standard

shader:
  source: assets://shaders/Standard.slang
  generics:
    - name: LIGHT_MODEL
      value: PBR

techniques:
  - name: Forward
    vertex_shader: vsMain
    pixel_shader: psMain
  - name: GBuffer
    vertex_shader: vsMain
    pixel_shader: psGBuffer
  - name: ShadowCaster
    vertex_shader: vsShadow

render_state:
  rasterization:
    cull_mode: Back
    front_face: CounterClockwise
  depth:
    test: true
    write: true
    compare_op: LessEqual
  blending:
    mode: Opaque

instance_data:
  - name: roughness_factor
    value:
      float: 0.5
  - name: metallic_factor
    value:
      float: 0.0
  - name: normal_texture_scale
    value:
      float: 1.0
  - name: emissive_factor
    value:
      float3:
        x: 0.0
        y: 0.0
        z: 0.0
  - name: base_colour_factor
    value:
      float4:
        x: 1.0
        y: 1.0
        z: 1.0
        w: 1.0
  - name: base_color_texture
    value:
      texture: sys://textures/white
  - name: metallic_roughness_texture
    value:
      texture: sys://textures/black
