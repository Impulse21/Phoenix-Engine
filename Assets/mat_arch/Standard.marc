asset_type: MaterialArchetype
name: Standard

shader:
  source: art://Shaders/Standard.slang
  generics:
    LIGHT_MODEL: PBR

# Mapping passes to shader entry points
techniques:
  Forward:
    vertex: vsMain
    fragment: psMain
  GBuffer:
    vertex: vsMain
    fragment: psGBuffer
  ShadowCaster:
    vertex: vsShadow
    # No fragment shader implies null/void
    fragment: null

render_state:
  rasterization:
    cull_mode: Back
    front_face: CounterClockwise
  depth:
    test: true
    write: true
    compare_op: LessEqual
  blending:
    mode: Opaque

properties:
  base_colour_factor: [1.0, 1.0, 1.0, 1.0]
  emissive_factor: [ 0.0, 0.0, 0.0]
  roughness_factor: 0.5
  metallic_factor: 0.0
  normal_texture_scale: 1.0
  base_color_texture: sys://textures/white
  metallic_roughness_texture: sys://textures/black